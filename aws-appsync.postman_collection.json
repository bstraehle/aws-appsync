{
	"info": {
		"_postman_id": "2cdd71cb-35e9-402c-82a7-d0d5c5ec9e5f",
		"name": "aws-appsync",
		"description": "Set graphqlUrl (stack output GraphQLUrl) and apiKey, then run the requests in order; createDemo stores demoId for the others.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "createDemo",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "x-api-key",
						"value": "{{apiKey}}",
						"type": "text"
					}
				],
				"body": {
					"mode": "graphql",
					"graphql": {
						"query": "mutation createDemo($input: CreateDemoInput!) {\n  createDemo(input: $input) { id name createdAt updatedAt }\n}",
						"variables": "{\n  \"input\": {\n    \"name\": \"Hello, World!\"\n  }\n}"
					}
				},
				"url": {
					"raw": "{{graphqlUrl}}",
					"host": [
						"{{graphqlUrl}}"
					]
				}
			},
			"response": [],
			"event": [
				{
					"listen": "test",
					"script": {
						"type": "text/javascript",
						"exec": [
							"pm.test(\"no GraphQL errors\", () => pm.expect(pm.response.json().errors).to.be.undefined);",
							"pm.collectionVariables.set(\"demoId\", pm.response.json().data.createDemo.id);"
						]
					}
				}
			]
		},
		{
			"name": "getDemo",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "x-api-key",
						"value": "{{apiKey}}",
						"type": "text"
					}
				],
				"body": {
					"mode": "graphql",
					"graphql": {
						"query": "query getDemo($id: ID!) {\n  getDemo(id: $id) { id name createdAt updatedAt }\n}",
						"variables": "{\n  \"id\": \"{{demoId}}\"\n}"
					}
				},
				"url": {
					"raw": "{{graphqlUrl}}",
					"host": [
						"{{graphqlUrl}}"
					]
				}
			},
			"response": [],
			"event": [
				{
					"listen": "test",
					"script": {
						"type": "text/javascript",
						"exec": [
							"pm.test(\"no GraphQL errors\", () => pm.expect(pm.response.json().errors).to.be.undefined);"
						]
					}
				}
			]
		},
		{
			"name": "listDemos",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "x-api-key",
						"value": "{{apiKey}}",
						"type": "text"
					}
				],
				"body": {
					"mode": "graphql",
					"graphql": {
						"query": "query listDemos($filter: DemoFilterInput, $limit: Int, $nextToken: String) {\n  listDemos(filter: $filter, limit: $limit, nextToken: $nextToken) {\n    items { id name createdAt updatedAt }\n    nextToken\n  }\n}",
						"variables": "{\n  \"filter\": {\n    \"name\": {\n      \"beginsWith\": \"Hello\"\n    }\n  },\n  \"limit\": 20\n}"
					}
				},
				"url": {
					"raw": "{{graphqlUrl}}",
					"host": [
						"{{graphqlUrl}}"
					]
				}
			},
			"response": [],
			"event": [
				{
					"listen": "test",
					"script": {
						"type": "text/javascript",
						"exec": [
							"pm.test(\"no GraphQL errors\", () => pm.expect(pm.response.json().errors).to.be.undefined);"
						]
					}
				}
			]
		},
		{
			"name": "updateDemo",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "x-api-key",
						"value": "{{apiKey}}",
						"type": "text"
					}
				],
				"body": {
					"mode": "graphql",
					"graphql": {
						"query": "mutation updateDemo($input: UpdateDemoInput!) {\n  updateDemo(input: $input) { id name createdAt updatedAt }\n}",
						"variables": "{\n  \"input\": {\n    \"id\": \"{{demoId}}\",\n    \"name\": \"Hello again\"\n  }\n}"
					}
				},
				"url": {
					"raw": "{{graphqlUrl}}",
					"host": [
						"{{graphqlUrl}}"
					]
				}
			},
			"response": [],
			"event": [
				{
					"listen": "test",
					"script": {
						"type": "text/javascript",
						"exec": [
							"pm.test(\"no GraphQL errors\", () => pm.expect(pm.response.json().errors).to.be.undefined);"
						]
					}
				}
			]
		},
		{
			"name": "deleteDemo",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "x-api-key",
						"value": "{{apiKey}}",
						"type": "text"
					}
				],
				"body": {
					"mode": "graphql",
					"graphql": {
						"query": "mutation deleteDemo($input: DeleteDemoInput!) {\n  deleteDemo(input: $input) { id name createdAt updatedAt }\n}",
						"variables": "{\n  \"input\": {\n    \"id\": \"{{demoId}}\"\n  }\n}"
					}
				},
				"url": {
					"raw": "{{graphqlUrl}}",
					"host": [
						"{{graphqlUrl}}"
					]
				}
			},
			"response": [],
			"event": [
				{
					"listen": "test",
					"script": {
						"type": "text/javascript",
						"exec": [
							"pm.test(\"no GraphQL errors\", () => pm.expect(pm.response.json().errors).to.be.undefined);"
						]
					}
				}
			]
		}
	],
	"variable": [
		{
			"key": "graphqlUrl",
			"value": "https://<api-id>.appsync-api.<region>.amazonaws.com/graphql"
		},
		{
			"key": "apiKey",
			"value": "<api-key>"
		},
		{
			"key": "demoId",
			"value": ""
		}
	]
}
